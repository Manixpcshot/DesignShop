{
  "name": "designshop",
  "productName": "DesignShop",
  "version": "1.0.0",
  "description": "DesignShop — a friendly Photoshop-class editor for thumbnails & social graphics. EN/FA. Windows, Linux & Arch.",
  "main": "electron/main.js",
  "type": "module",
  "author": {
    "name": "DesignShop",
    "email": "hello@designshop.app"
  },
  "homepage": "https://github.com/Manixpcshot/DesignShop",
  "license": "MIT",
  "keywords": [
    "design",
    "editor",
    "thumbnail",
    "photoshop",
    "tauri",
    "electron"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win --publish never",
    "electron:build:linux": "npm run build && electron-builder --linux --publish never",
    "electron:build:dir": "npm run build && electron-builder --dir",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node tests/smoke.mjs",
    "test:ssr": "node tests/run-ssr.mjs",
    "test:all": "npm run test && npm run test:ssr",
    "bump": "node scripts/bump-version.mjs",
    "check": "node scripts/check-sources.mjs && node scripts/check-i18n.mjs && node scripts/check-assets.mjs",
    "package:all": "npm run build && node scripts/build-local.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.0.19",
    "@fontsource/archivo-black": "^5.0.19",
    "@fontsource/bebas-neue": "^5.0.19",
    "@fontsource/inter": "^5.0.19",
    "@fontsource/lobster": "^5.0.19",
    "@fontsource/montserrat": "^5.0.19",
    "@fontsource/orbitron": "^5.0.19",
    "@fontsource/oswald": "^5.0.19",
    "@fontsource/permanent-marker": "^5.0.19",
    "@fontsource/playfair-display": "^5.0.19",
    "@fontsource/poppins": "^5.0.19",
    "@fontsource/space-grotesk": "^5.0.19",
    "@fontsource/vazirmatn": "^5.0.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.designshop.desktop",
    "productName": "DesignShop",
    "copyright": "Copyright © 2026 DesignShop",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DesignShop",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-portable-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Graphics",
      "synopsis": "Photo & thumbnail editor",
      "description": "DesignShop is a beginner-friendly, Photoshop-class image editor with a thumbnail studio, built with Electron and Tauri (Rust).",
      "maintainer": "DesignShop <hello@designshop.app>",
      "desktop": {
        "entry": {
          "Name": "DesignShop",
          "Comment": "Photo & thumbnail editor",
          "Categories": "Graphics;Photography;2DGraphics;",
          "Keywords": "design;photo;editor;thumbnail;graphics;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
